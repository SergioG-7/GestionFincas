PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_fincas
# DB_SSL=true habilita TLS (necesario para proveedores en la nube como Aiven)
DB_SSL=false

# Clave secreta para firmar los JWT de sesion. Genera una propia, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Credenciales del unico usuario autorizado (sin registro publico)
AUTH_USERNAME=
AUTH_PASSWORD=
